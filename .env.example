# 环境变量模板（复制为 .env 并填写，.env 已被 git 忽略，请勿提交真实值）
# Railway 会自动注入 MYSQL* 变量，本文件仅作本地参考。

# 后台登录密码（必填，生产环境务必修改）
ADMIN_PASSWORD=your_admin_password_here

# 会话签名密钥（可选；不填则每次启动随机，导致重启后需重新登录）
SESSION_SECRET=change_me_to_a_long_random_string

# 设为 production 时后台 cookie 标记 Secure（Railway 建议）
NODE_ENV=production

# Railway MySQL 插件自动注入（本地可留空，将回退到 posts/*.md 文件）
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=
# MYSQLDATABASE=railway
